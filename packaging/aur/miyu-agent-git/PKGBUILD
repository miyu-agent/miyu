# Maintainer: SHORiN <shorin@users.noreply.github.com>
#
# Miyu 从源码编的一整套（施工 RL-5，设计 60 第二节）：核心、终端、网页一个包，provides、conflicts 那几个分开的包（AUR 的
# 惯例，免得每个都要一个 -git）。不是模板，照原样发。
#
# 编法同发版：`cargo xtask dist` 照 heads.toml 取两个头一起编、打包（要 rustup，头照各自的 rust-toolchain.toml 编；要 python3
# 搭网页的包文件夹；要网络取头和依赖），再照分包的三份装：核心进 /usr/lib/miyu/，终端、网页进 /usr/share/miyu/packages/，
# 同 miyu-core、miyu-tui、miyu-webui。旧版的 miyu 同 miyu-core 只挡 0.7.x 那一代、不 provides（施工 RL-5补2）：过渡包 miyu 依赖
# miyu-agent，这里 provides 它，装了过渡包也能换成这一份。

pkgname=miyu-agent-git
pkgver=0.0.0.r0.g0000000
pkgrel=1
pkgdesc='Miyu, an AI assistant that runs on your own computer: the core with the terminal and web interfaces, built from the latest source'
arch=('x86_64' 'aarch64')
url='https://github.com/miyu-agent/miyu'
license=('AGPL-3.0-or-later')
depends=('glibc' 'gcc-libs')
makedepends=('git' 'rustup' 'python')
optdepends=('bubblewrap: sandbox commands with mounts (Landlock alone otherwise)')
provides=('miyu-core' 'miyu-tui' 'miyu-webui' 'miyu-agent')
conflicts=('miyu<2026' 'miyu-core' 'miyu-tui' 'miyu-webui' 'miyu-agent')
options=('!strip' '!debug' '!lto')
source=("miyu::git+${url}.git")
sha256sums=('SKIP')

_workspace_version() {
  sed -n '/^\[workspace\.package\]/,/^\[/s/^version = "\(.*\)"$/\1/p' "${srcdir}/miyu/Cargo.toml"
}

pkgver() {
  cd miyu
  printf '%s.r%s.g%s' "$(_workspace_version | tr -d '-')" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd miyu
  rustup toolchain install
  cargo xtask dist --out "${srcdir}/dist"
}

package() {
  local version target
  version=$(_workspace_version)
  target="linux-${CARCH}"
  cd "${srcdir}/dist"
  rm -rf unpacked
  mkdir unpacked
  tar -xzf "miyu-core-${version}-${target}.tar.gz" -C unpacked
  tar -xzf miyu-tui-*-"${target}".tar.gz -C unpacked
  tar -xzf miyu-webui-*-"${target}".tar.gz -C unpacked

  install -d "${pkgdir}/usr/lib/miyu" "${pkgdir}/usr/bin" "${pkgdir}/usr/share/miyu/packages"
  cp -a "unpacked/miyu-core-${version}-${target}/." "${pkgdir}/usr/lib/miyu/"
  printf '# AUR 的 miyu-agent-git 装的：miyu upgrade 说用包管理器升级。\nchannel = "aur"\n' > "${pkgdir}/usr/lib/miyu/install.toml"
  ln -s /usr/lib/miyu/miyu "${pkgdir}/usr/bin/miyu"
  cp -a unpacked/miyu-tui unpacked/miyu-webui "${pkgdir}/usr/share/miyu/packages/"
  install -Dm644 "unpacked/miyu-core-${version}-${target}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${srcdir}/miyu/packaging/mime/miyu.xml" "${pkgdir}/usr/share/mime/packages/miyu.xml"
}
