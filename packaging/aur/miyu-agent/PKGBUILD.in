#
# Miyu 的合集（施工 RL-5、RL-5补，设计 60 第二节）：不带文件，只依赖核心、终端、网页、托盘四个包，装它就是装一整套。
# 这个文件是模板，由 `cargo xtask packaging <标签> --sums <SHA256SUMS>` 填好版本再发；别手改填出来的那份。

pkgname=miyu-agent
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Miyu, an AI assistant that runs on your own computer: the core with the terminal, web and tray apps'
arch=('any')
url='https://github.com/miyu-agent/miyu'
license=('AGPL-3.0-or-later')
depends=('miyu-core' 'miyu-tui' 'miyu-webui' 'miyu-applet')
